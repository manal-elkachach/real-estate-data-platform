# Copy this file to ".env" in the same folder before running docker compose.
# ".env" itself must NEVER be committed to Git (add it to .gitignore) --
# only ".env.example" (with placeholder values) belongs in the repo.
# This is a real data engineering practice: credentials are configuration,
# not code, and never get hard-coded into scripts or docker-compose.yml.

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

POSTGRES_USER=dwh_user
POSTGRES_PASSWORD=dwh_password123
POSTGRES_DB=real_estate_dwh
